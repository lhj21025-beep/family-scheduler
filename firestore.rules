rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function myFamilyId() {
      return get(/databases/$(database)/documents/members/$(request.auth.uid)).data.familyId;
    }

    match /members/{memberId} {
      allow read, write: if signedIn() && request.auth.uid == memberId;
    }

    match /events/{eventId} {
      allow read: if signedIn() && myFamilyId() == resource.data.familyId;
      allow create: if signedIn() && myFamilyId() == request.resource.data.familyId;
      allow update: if signedIn() && myFamilyId() == resource.data.familyId && myFamilyId() == request.resource.data.familyId;
      allow delete: if signedIn() && myFamilyId() == resource.data.familyId;
    }

    match /families/{familyId} {
      allow read, write: if signedIn();
    }
  }
}
