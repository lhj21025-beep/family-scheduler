rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInFamily() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'dad@family-scheduler.app',
          'mom@family-scheduler.app',
          'son@family-scheduler.app'
        ];
    }

    // New low-read storage model: one document per calendar day.
    match /scheduleDays/{dayId} {
      allow read, write: if signedInFamily();
    }

    // Small shared metadata document: homework definitions + recent family notices.
    match /familyData/{familyId} {
      allow read, write: if signedInFamily() && familyId == 'family-main';
    }

    // Legacy collections remain readable/writable for the one-time migration.
    match /events/{eventId} {
      allow read, write: if signedInFamily();
    }

    match /homeworks/{homeworkId} {
      allow read, write: if signedInFamily();
    }

    match /notices/{noticeId} {
      allow read, write: if signedInFamily();
    }

    match /members/{memberId} {
      allow read, write: if signedInFamily() && request.auth.uid == memberId;
    }

    match /families/{familyId} {
      allow read, write: if signedInFamily();
    }
  }
}
